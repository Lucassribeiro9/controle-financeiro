{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery.local/contracts/findings.schema.json",
  "title": "Findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "$defs": {
    "severity": {"enum": ["informational", "warning", "blocking"]},
    "classification": {"enum": ["local", "material"]},
    "returnTo": {"enum": ["execute", "re_review"]}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "severity", "classification", "type", "description", "return_to"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"$ref": "#/$defs/severity"},
          "classification": {"$ref": "#/$defs/classification"},
          "type": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "return_to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {"type": {"$ref": "#/$defs/returnTo"}}
          }
        }
      }
    }
  }
}
