{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery.local/contracts/project-manifest.schema.json",
  "title": "Project Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project", "repository"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "required": ["default_branch"],
      "properties": {"default_branch": {"type": "string", "minLength": 1}}
    },
    "stack": {"type": "object"},
    "sources": {"type": "object"},
    "git": {"type": "object"},
    "testing": {"type": "object"},
    "capabilities": {"type": "object"},
    "delivery": {"type": "object"}
  }
}
