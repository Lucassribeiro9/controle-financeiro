# artefato de producao do projeto (desenvolvimento usa docker-compose.yml)
FROM python:3.12-alpine

# variáveis de ambiente para Python/pip
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# usuário sem privilégios (uid 1000 coincide com o usuário comum do host no dev)
RUN adduser -D -u 1000 app

# criar diretório de trabalho
WORKDIR /app

# copiar arquivos de requisitos e instalar dependências
COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# copiar o restante do código para o container
COPY --chown=app:app . .

# coletar estáticos com as settings de produção; a chave abaixo é gerada só
# para este build e não é gravada na imagem final
RUN DJANGO_SECRET_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(50))')" \
    DJANGO_ALLOWED_HOSTS=build \
    python manage.py collectstatic --noinput \
    && chown -R app:app /app

USER app

EXPOSE 8000
CMD ["gunicorn", "project.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
