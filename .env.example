# Desenvolvimento local usa project.settings.dev e NAO precisa de nenhuma variavel.
#
# Producao (docker-compose.prod.yml): defina as variaveis abaixo. Nunca versione
# o .env real. Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Caminho do banco SQLite dentro do container; deve ficar no volume montado em /data
DJANGO_DB_PATH=/data/db.sqlite3
# Opcional: origens HTTPS confiaveis separadas por virgula (ex.: https://app.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
# HSTS em segundos; suba (ex.: 31536000) somente depois de validar o HTTPS
DJANGO_SECURE_HSTS_SECONDS=3600
# true quando um proxy/load balancer termina o TLS e envia X-Forwarded-Proto
DJANGO_SECURE_PROXY_SSL_HEADER=false
