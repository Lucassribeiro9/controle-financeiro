   "text": "FIN-34 · Wireframes celular (360px) — estrutura, sem visual final",
   "originalText": "FIN-34 · Wireframes celular (360px) — estrutura, sem visual final",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
